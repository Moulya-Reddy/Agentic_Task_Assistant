# Copy this file to .env and fill in your key (never commit the real .env)

# Default provider: Groq. Free tier, no credit card required.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional: only needed if you set provider="anthropic" (pay-as-you-go,
# no ongoing free tier). Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here
